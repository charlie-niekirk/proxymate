{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxymate",
  "version": "0.3.0",
  "identifier": "dev.proxymate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @proxymate/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @proxymate/ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Proxymate",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: pmicon: http://pmicon.localhost pmbody: http://pmbody.localhost; media-src 'self' blob: pmbody: http://pmbody.localhost; frame-src 'self' blob: pmbody: http://pmbody.localhost; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost pmbody: http://pmbody.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "HTTP(S) debugging proxy",
    "copyright": "© 2026 Charlie Niekirk",
    "macOS": {
      "minimumSystemVersion": "13.3",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBREFCREMyQUYwNzQ4ODEKUldTQlNBZXZ3cjNhT3E4QzJRbEtISmFySzAzYmtJWEw5Q2pDcHhVVVJDTWNqOENQQ0JzWWdYK3YK",
      "endpoints": ["https://github.com/charlie-niekirk/proxymate/releases/latest/download/latest.json"]
    }
  }
}
