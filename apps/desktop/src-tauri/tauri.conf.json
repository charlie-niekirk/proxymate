{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxymate",
  "version": "0.1.0",
  "identifier": "dev.proxymate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @proxymate/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @proxymate/ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Proxymate",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 22 },
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
